{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iris-lumera-lms",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iris-lumera-db",
      "database_id": "3de90461-7851-4733-a6a6-198bd9d25464",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "IRIS LUMERA",
    "SUPPORT_EMAIL": "irislumera@hotmail.com",
    "SESSION_DAYS": "7",
    "SCORM_MAX_BYTES": "26214400"
  }
}
